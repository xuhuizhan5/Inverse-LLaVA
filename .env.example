# All paths are explicit; no script writes to a home-directory cache by default.
INVLLAVA_DATA_ROOT=/workspace/data
INVLLAVA_RUN_ROOT=/workspace/runs
INVLLAVA_CACHE_ROOT=/workspace/cache
HF_HOME=/workspace/cache/huggingface
TORCH_EXTENSIONS_DIR=/workspace/cache/torch_extensions
TORCHINDUCTOR_CACHE_DIR=/workspace/cache/torchinductor
TRITON_CACHE_DIR=/workspace/cache/triton
WANDB_MODE=offline
# Set only in a frozen scientific source tree.
# INVLLAVA_EXECUTION_SOURCE_SHA256=<64-lowercase-hex>
# INVLLAVA_REPRODUCTION_MANIFEST=configs/reproduction/training_local.yaml
# WANDB_PROJECT=inverse-llava
# HF_TOKEN=inject-with-the-host-secret-manager; never commit a real token
# Enable only after every required Hub snapshot is frozen and locally present.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# OPENAI_API_KEY=only-needed-for-frozen-judge-protocols
